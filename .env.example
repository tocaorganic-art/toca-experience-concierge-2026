# Variáveis de ambiente para o Toca Experience Concierge 2026
# Copie este arquivo para .env e preencha com seus valores

# Node Environment
NODE_ENV=production
PORT=3000

# Analytics (Umami)
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your-website-id-here

# Project Title
VITE_PROJECT_TITLE=Toca Experience Concierge

# Database (Supabase/MySQL)
DATABASE_URL=mysql://user:password@host:port/database

# OAuth
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# AWS S3 Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# JWT Secret (para sessões)
JWT_SECRET=your-secret-key-here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
